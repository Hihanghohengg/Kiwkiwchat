# ═══════════════════════════════════════════════════════════════
# Kiw Kiw Chat — Environment Variables
# Copy to .env and fill in your values before deploying.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Backend ───────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Must match the URL users access (include https://)
ALLOWED_ORIGINS=https://kiwkiw.chat,https://www.kiwkiw.chat

# Optional: TURN server for WebRTC (improves connectivity behind strict NAT)
# Recommended: deploy coturn or use a managed service (Twilio, Metered)
TURN_URL=turn:turn.kiwkiw.chat:3478
TURN_USERNAME=kiwkiw
TURN_CREDENTIAL=your_strong_turn_secret_here

# Security tunables (defaults shown)
MAX_MSG_BYTES=5242880        # max WebSocket JSON message size in bytes (5 MB)
MAX_FILE_BYTES=52428800      # max file transfer metadata size in bytes (50 MB)
WS_IDLE_TIMEOUT=60           # seconds before idle WebSocket is closed (60 s)
ROOM_TTL_SECONDS=900         # seconds before a room self-destructs (15 min)
# Rate limit: 10 rooms per IP per minute (set in main.py @limiter.limit decorator)

# ── Frontend (baked into JS bundle at build time) ─────────────
# Must match your production domain + protocol
VITE_API_URL=https://kiwkiw.chat
VITE_WS_URL=wss://kiwkiw.chat

# ── Deployment (used by Kamal) ────────────────────────────────
# GitHub Container Registry Personal Access Token
# Required scopes: read:packages, write:packages, delete:packages
# Create at: https://github.com/settings/tokens
KAMAL_REGISTRY_PASSWORD=ghp_your_token_here

# Production server public IP address
KAMAL_WEB_IP=your.server.ip.address
