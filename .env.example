# ═══════════════════════════════════════════════════════════════
# Kiw Kiw Chat — Environment Variables
# Copy to .env and fill in your values before deploying.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Backend ───────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Must match the URL users access (include https://)
ALLOWED_ORIGINS=https://kiwkiwchat.vercel.app,http://localhost:5173,http://localhost:4173

# Optional: TURN server for WebRTC (improves connectivity behind strict NAT)
# Recommended: deploy coturn or use a managed service (Twilio, Metered)
TURN_URL=turn:turn.kiwkiw.chat:3478
TURN_USERNAME=kiwkiw
TURN_CREDENTIAL=your_strong_turn_secret_here

# Security tunables (defaults shown matching backend/main.py)
MAX_MSG_BYTES=65536           # max WebSocket JSON message size in bytes (64 KB)
WS_IDLE_TIMEOUT=60            # seconds before idle WebSocket is closed (60 s)
ROOM_TTL_SECONDS=900          # seconds before a room self-destructs (15 min / 900 s)
# Rate limit: 10 rooms per IP per minute (configured via SlowAPI decorator in main.py)

# ── Frontend (baked into JS bundle at build time) ─────────────
# Must match your production domain + protocol
VITE_API_URL=https://kiwkiw.chat
VITE_WS_URL=wss://kiwkiw.chat
